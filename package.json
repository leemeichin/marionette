{
  "name": "marionette",
  "version": "0.1.0",
  "description": "A compiled, plain-text project trajectory language — authored by humans, validated by a compiler, traversed by AI agents.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/pi-extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "marionette": "./bin/marionette.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "src",
    "spec",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench:engine": "node --import tsx bench/engine.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:pi": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.8",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "swipl-wasm": "^8.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
