flowchart TD
  export_content["<b>export_content</b><br/>Export the full WordPress site: posts, pages, and the ent…"]
  manual_export["<b>manual_export</b><br/>Fallback extraction: pull post content straight from the …"]
  convert_to_markdown["<b>convert_to_markdown</b><br/>Convert exported posts to Hugo markdown with front matter…"]
  build_theme["<b>build_theme</b><br/>Install and customise the Hugo theme until the site looks…"]
  preview_for_jo["<b>preview_for_jo</b><br/>Deploy the Hugo site to a private staging URL and walk Jo…"]
  cutover["<b>cutover</b><br/>Point the domain's DNS at the new Hugo hosting, leaving t…"]
  verify_live["<b>verify_live</b><br/>Spot-check the live domain: recent and old posts, images,…"]
  retire_wordpress["<b>retire_wordpress</b><br/>Take a final full backup of the WordPress database and fi…"]
  reassess["<b>reassess</b><br/>The migration hit a wall somewhere; decide whether to cha…"]
  export_content -- "Export verified complete" --> convert_to_markdown
  export_content -- "Exporter broken or archive incomplete" --> manual_export
  manual_export -- "Content and media recovered" --> convert_to_markdown
  manual_export -- "✋ Cannot recover everything" --> reassess
  convert_to_markdown -- "All posts render, images and links resolve" --> build_theme
  convert_to_markdown -. "↻ Fix conversion glitches and re-run {convert_rounds &lt; 5}" .-> convert_to_markdown
  convert_to_markdown -- "✋ Conversion not converging {convert_rounds &gt;= 5}" --> reassess
  build_theme -- "Theme looks right locally" --> preview_for_jo
  build_theme -. "↻ Iterate on templates and styles {theme_rounds &lt; 5}" .-> build_theme
  build_theme -- "✋ Theme work not converging {theme_rounds &gt;= 5}" --> reassess
  preview_for_jo -- "✋ Jo approves the design" --> cutover
  preview_for_jo -. "✋ ↻ Jo wants changes {jo_rounds &lt; 4}" .-> build_theme
  preview_for_jo -- "✋ Design reviews not converging {jo_rounds &gt;= 4}" --> reassess
  cutover -- "DNS updated and propagated" --> verify_live
  verify_live -- "Everything checks out" --> retire_wordpress
  verify_live -. "↻ Broken in production; roll DNS back and fix {cutover_attempts &lt; 3}" .-> cutover
  verify_live -- "✋ Cutover keeps failing {cutover_attempts &gt;= 3}" --> reassess
  retire_wordpress -- "✋ Backup archived; WordPress decommissioned" --> END
  reassess -. "✋ ↻ Adjust approach and resume from conversion" .-> convert_to_markdown
  reassess -- "✋ Shelve the migration; WordPress stays live" --> END
  END(((END)))
