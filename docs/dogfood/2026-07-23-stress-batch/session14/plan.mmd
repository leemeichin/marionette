flowchart TD
  greybox_prototype["<b>greybox_prototype</b><br/>Greybox the core loop prototype: playable mechanics, plac…"]
  core_loop_iteration["<b>core_loop_iteration</b><br/>Weekly playtest and iteration on the core loop."]
  scope_change_pitch["<b>scope_change_pitch</b><br/>Pitch the publisher a scope change instead of grinding on…"]
  production_art_audio["<b>production_art_audio</b><br/>Production art and audio for the vertical slice, replacin…"]
  polish_pass["<b>polish_pass</b><br/>Polish pass across the slice: feel, transitions, bugs, pe…"]
  playtest_gauntlet["<b>playtest_gauntlet</b><br/>Run one internal playtest session and measure the positiv…"]
  gauntlet_streak["<b>gauntlet_streak</b><br/>Record the positive session and check the streak."]
  gauntlet_reset["<b>gauntlet_reset</b><br/>A session missed the bar, so the streak resets to zero."]
  submit_milestone["<b>submit_milestone</b><br/>Package and submit the vertical slice milestone to the pu…"]
  publisher_review["<b>publisher_review</b><br/>The publisher reviews the milestone against the contract."]
  rework["<b>rework</b><br/>Address the publisher's notes on the slice."]
  cure_period["<b>cure_period</b><br/>The contract's cure period: do-or-die."]
  greybox_prototype -- "Core loop playable in greybox" --> core_loop_iteration
  core_loop_iteration -- "✋ Creative director calls it fun" --> production_art_audio
  core_loop_iteration -. "↻ Not fun yet, iterate another week {playtest_weeks &lt; 8}" .-> core_loop_iteration
  core_loop_iteration -- "Eight weeks in, still not fun {playtest_weeks &gt;= 8}" --> scope_change_pitch
  scope_change_pitch -. "✋ ↻ Publisher approves the new scope" .-> greybox_prototype
  scope_change_pitch -- "✋ Publisher declines, proceed with the best current loop" --> production_art_audio
  production_art_audio -- "Slice content complete" --> polish_pass
  polish_pass -- "Polish bar met, start the gauntlet" --> playtest_gauntlet
  playtest_gauntlet -- "Session above 80 percent positive" --> gauntlet_streak
  playtest_gauntlet -- "Session at or below 80 percent positive" --> gauntlet_reset
  gauntlet_streak -- "Three consecutive wins, submit the slice {positive_streak &gt;= 3}" --> submit_milestone
  gauntlet_streak -. "↻ Streak alive, run the next session {positive_streak &lt; 3}" .-> playtest_gauntlet
  gauntlet_reset -. "↻ Fold feedback into another polish round" .-> polish_pass
  gauntlet_reset -- "✋ Gauntlet is not converging, leadership decides to submit as-is" --> submit_milestone
  submit_milestone --> publisher_review
  publisher_review -- "✋ Pass, funding continues" --> END
  publisher_review -- "✋ Notes, one rework round granted {rework_rounds &lt; 1}" --> rework
  publisher_review -- "✋ Hard fail, cure period triggered" --> cure_period
  rework -. "↻ Resubmit the revised slice" .-> publisher_review
  cure_period -- "✋ Spend our runway to fix it" --> rework
  cure_period -- "✋ Negotiate an exit with the publisher" --> END
  END(((END)))
