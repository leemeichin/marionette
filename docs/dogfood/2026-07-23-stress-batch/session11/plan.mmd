flowchart TD
  lock_venue["<b>lock_venue</b><br/>Lock the venue for next spring: negotiate and sign the co…"]
  run_cfp["<b>run_cfp</b><br/>Run the call for proposals for six weeks: publicity, subm…"]
  select_program["<b>select_program</b><br/>Program committee reviews submissions and picks the talks."]
  chase_confirmations["<b>chase_confirmations</b><br/>Chase speaker confirmations for every slot in the draft p…"]
  replacement_pick["<b>replacement_pick</b><br/>Program committee picks a replacement talk for the declin…"]
  announce_program["<b>announce_program</b><br/>Announce the program and open ticket sales."]
  sponsorship_checkpoint["<b>sponsorship_checkpoint</b><br/>Sponsorships have been running alongside; at three months…"]
  downsize_scope["<b>downsize_scope</b><br/>Downsize catering and the after-party to fit the sponsors…"]
  final_prep["<b>final_prep</b><br/>Final logistics: schedule, AV, catering at the agreed sco…"]
  go_no_go["<b>go_no_go</b><br/>Two weeks before the date: go/no-go review with the direc…"]
  postpone_and_refund["<b>postpone_and_refund</b><br/>Postpone the conference to autumn and refund every ticket…"]
  run_event["<b>run_event</b><br/>Run the conference for its 300 attendees."]
  wrap_up["<b>wrap_up</b><br/>Pay the invoices and run the retrospective."]
  lock_venue -- "✋ Director signs the venue contract" --> run_cfp
  lock_venue -. "✋ ↻ Terms not right yet — renegotiate" .-> lock_venue
  run_cfp -- "CFP window closed" --> select_program
  select_program -- "✋ Committee has picked the program" --> chase_confirmations
  chase_confirmations -- "All slots confirmed — program is full" --> announce_program
  chase_confirmations -- "A speaker declined" --> replacement_pick
  replacement_pick -. "✋ ↻ Replacement chosen — chase their confirmation" .-> chase_confirmations
  announce_program -- "Program announced, tickets selling" --> sponsorship_checkpoint
  sponsorship_checkpoint -- "At or above 60% of the sponsorship target" --> final_prep
  sponsorship_checkpoint -- "Under 60% of the sponsorship target" --> downsize_scope
  downsize_scope -- "✋ Reduced scope approved" --> final_prep
  final_prep -- "Ready for the go/no-go review" --> go_no_go
  go_no_go -- "✋ Go — ticket sales are healthy enough" --> run_event
  go_no_go -- "✋ No-go — ticket sales catastrophically low" --> postpone_and_refund
  postpone_and_refund -- "Refunds issued, postponement announced" --> END
  run_event -- "Event delivered" --> wrap_up
  wrap_up -- "Invoices paid, retro complete" --> END
  END(((END)))
