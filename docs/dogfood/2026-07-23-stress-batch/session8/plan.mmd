  monolith_freeze_booking -- "Freeze window agreed and booked" --> monolith_capacity_signoff
  monolith_capacity_signoff -- "✋ SRE signs off capacity" --> monolith_migration
  monolith_capacity_signoff -. "✋ ↻ SRE flags gaps, remediate and rebook the window" .-> monolith_freeze_booking
  monolith_migration -. "↻ Freeze window pulled by support, rebook it" .-> monolith_freeze_booking
  monolith_migration -- "Monolith live on the PaaS" --> program_review
  arch_board_review -. "✋ ↻ Board approves a revised auth approach, restart that extraction" .-> auth_extraction
  arch_board_review -. "✋ ↻ Board approves a revised billing approach, restart that extraction" .-> billing_extraction
  arch_board_review -- "✋ Board halts the programme" --> END
  program_review -- "✋ Decommission the old estate" --> END
  program_review -- "✋ Keep the old estate warm for a quarter" --> keep_warm
  keep_warm -- "✋ Insurance quarter elapsed, decommission the old estate" --> END
  END(((END)))
