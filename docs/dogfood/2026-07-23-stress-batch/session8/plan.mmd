  observability_build -- "Stack live, dashboards and alerts verified" --> auth_extraction
  auth_extraction -- "Extraction complete, start shadowing" --> auth_shadow
  auth_shadow -- "Parity metrics held for two weeks" --> auth_capacity_signoff
