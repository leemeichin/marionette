  billing_shadow -. "↻ Parity drifting, rework the extraction" .-> billing_extraction
  billing_reconciliation -- "✋ Finance confirms the month reconciles to the penny" --> billing_capacity_signoff
  billing_reconciliation -. "✋ ↻ Discrepancies found, fix and re-run a ledger month" .-> billing_shadow
  billing_capacity_signoff -- "✋ SRE signs off capacity" --> billing_cutover
  billing_capacity_signoff -. "✋ ↻ SRE flags gaps, remediate and re-shadow" .-> billing_shadow
