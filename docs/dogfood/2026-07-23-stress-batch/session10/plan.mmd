flowchart TD
  bench_validation["<b>bench_validation</b><br/>Bench-validate the Rev B PCB: power rails, sensor reading…"]
  emc_precompliance["<b>emc_precompliance</b><br/>EMC pre-compliance testing at the lab: radiated and condu…"]
  emc_certification["<b>emc_certification</b><br/>Full EMC certification at the accredited lab. Done when t…"]
  board_respin["<b>board_respin</b><br/>Respin the PCB: incorporate fixes, re-layout, fabricate a…"]
  respin_review["<b>respin_review</b><br/>Two respins have been spent. Sit down with the hardware l…"]
  bom_finalization["<b>bom_finalization</b><br/>Firm up the bill of materials: lock part selections, conf…"]
  alternate_mcu_redesign["<b>alternate_mcu_redesign</b><br/>Redesign the board around the alternate MCU instead of wa…"]
  cm_quotes["<b>cm_quotes</b><br/>Request and compare quotes from two contract manufacturer…"]
  final_approval["<b>final_approval</b><br/>The hardware lead reviews and approves the final BOM and …"]
  place_production_order["<b>place_production_order</b><br/>Place the 500-unit production order with the chosen CM. T…"]
  production_run["<b>production_run</b><br/>The CM builds and delivers the 500-unit production run. D…"]
  bench_validation -- "Bench validation passes" --> emc_precompliance
  bench_validation -- "Hardware fault needs a board respin {respins &lt; 2}" --> board_respin
  bench_validation -- "Fault found but respin budget is spent {respins &gt;= 2}" --> respin_review
  emc_precompliance -- "Pre-compliance passes" --> emc_certification
  emc_precompliance -- "EMC failure, respin the board {respins &lt; 2}" --> board_respin
  emc_precompliance -- "EMC failure but respin budget is spent {respins &gt;= 2}" --> respin_review
  emc_certification -- "Certification passes" --> bom_finalization
  emc_certification -- "Certification failure, respin the board {respins &lt; 2}" --> board_respin
  emc_certification -- "Certification failure but respin budget is spent {respins &gt;= 2}" --> respin_review
  board_respin -. "↻ New rev in hand, back to the bench" .-> bench_validation
  respin_review -. "✋ ↻ Hardware lead funds another respin" .-> board_respin
  respin_review -- "✋ Halt the production effort" --> END
  bom_finalization -- "MCU lead time is within twelve weeks" --> cm_quotes
  bom_finalization -- "MCU lead time slips past twelve weeks" --> alternate_mcu_redesign
  alternate_mcu_redesign -. "↻ Redesign complete, new rev in hand" .-> bench_validation
  cm_quotes -- "Quotes in hand and compared" --> final_approval
  final_approval -- "✋ BOM and CM approved" --> place_production_order
  final_approval -. "✋ ↻ Changes requested, rework the BOM or quotes" .-> bom_finalization
  place_production_order -- "✋ Place the production order" --> production_run
  place_production_order -. "✋ ↻ Hold, revisit the BOM and quotes first" .-> bom_finalization
  production_run --> END
  END(((END)))
