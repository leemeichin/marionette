# project: dynamic-batch
# summary: Process a runtime-observed workload and check again after each pass.
VAR remaining: number = ?

=== work ===
Process one unit from the current workload.
~ remaining -= 1
while {remaining > 0} -> work
else -> refresh

=== refresh ===
Refresh the external workload.
? remaining
while {remaining > 0} -> work
else -> END
