    {
      "id": "scaffold_site",
      "body": "Scaffold the static site under docs-site/: dependency-free HTML/CSS/JS,\na Wrangler config for Cloudflare (static assets), and a local preview path.\nDone means the shell page deploy-ready and the design tokens rendering.",
      "actions": [],
      "choices": [],
