    {
      "id": "capture_reality",
      "body": "Run the real CLI against the worked examples and capture verbatim transcripts:\nvalidate (clean and failing), compile, render, summarize, state init/choose,\nand brief. These transcripts are the single source of truth — every terminal\nsnippet in the README and every interactive demo on the site must match them\nbyte-for-byte.",
      "actions": [],
      "choices": [],
      "divert": {
        "target": "rewrite_readme",
        "line": 18
      },
      "line": 12,
      "meta": {},
      "refs": []
    },
