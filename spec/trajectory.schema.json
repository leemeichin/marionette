{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leemeichin/marionette/spec/trajectory.schema.json",
  "title": "Marionette trajectory",
  "description": "The compiled contract between authoring/validation (Phase 1) and agent ingestion (Phase 2). Produced by `marionette compile`; consumed by the runtime/agent.",
  "type": "object",
  "required": ["spec", "hash", "source", "variables", "start", "nodes", "meta", "refs"],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "type": "string",
      "description": "Version of this document shape (semver).",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "hash": {
      "type": "string",
      "description": "sha256 over the canonical form of this document: sorted keys, no whitespace, with `hash`, `source` and all `line` fields excluded. State files bind to this value; a mismatch means plan/state drift.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "description": "Provenance. Not part of the hash.",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" }
      }
    },
    "variables": {
      "type": "object",
      "description": "Typed variable declarations, keyed by name.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "initial"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["number", "boolean", "string"] },
          "initial": {
            "description": "Literal initial value, or null for a late-bound runtime value.",
            "oneOf": [{ "$ref": "#/$defs/value" }, { "type": "null" }]
          },
          "line": { "type": "integer" }
        }
      }
    },
    "start": {
      "type": "string",
      "description": "Id of the entry node."
    },
    "nodes": {
      "type": "array",
      "description": "The phases of the trajectory, in authoring order.",
      "items": { "$ref": "#/$defs/node" }
    },
    "meta": { "$ref": "#/$defs/meta" },
    "refs": {
      "type": "array",
      "description": "External references normalised from the plan-level metadata (spec >= 0.2.0).",
      "items": { "$ref": "#/$defs/ref" }
    }
  },
  "$defs": {
    "value": {
      "type": ["number", "boolean", "string"]
    },
    "meta": {
      "type": "object",
      "description": "Namespaced extension metadata (e.g. `github:issue`). Extensions must use a `namespace:` key prefix so they never collide with the core contract. The reserved key `tags` holds bare tags.",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "ref": {
      "type": "object",
      "description": "A structured external reference (issue tracker, PR, document) normalised from namespaced metadata tags — consumers never re-parse meta conventions.",
      "required": ["provider", "kind", "id", "url"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "description": "Source system: \"github\", \"jira\", \"linear\", \"url\", … (open set)." },
        "kind": { "type": "string", "description": "What is referenced: \"issue\", \"pr\", \"repo\", \"link\", … (open set)." },
        "id": { "type": "string", "description": "Canonical identifier, e.g. \"acme/platform#12\", \"PROJ-123\", or a URL." },
        "url": {
          "description": "Browsable URL when derivable from the available context, else null.",
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "body", "actions", "observations", "choices", "next", "meta", "refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "body": { "type": "string", "description": "Prose description of the phase." },
        "actions": {
          "type": "array",
          "description": "Mutations applied when the node is entered, in order.",
          "items": { "$ref": "#/$defs/action" }
        },
        "observations": {
          "type": "array",
          "description": "Runtime values invalidated and requested after this phase's work.",
          "items": { "$ref": "#/$defs/observation" }
        },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "next": {
          "description": "Automatic next step when the phase is complete, or null.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["target"],
              "additionalProperties": false,
              "properties": {
                "target": { "$ref": "#/$defs/target" },
                "line": { "type": "integer" }
              }
            }
          ]
        },
        "line": { "type": "integer" },
        "meta": { "$ref": "#/$defs/meta" },
        "refs": {
          "type": "array",
          "description": "External references normalised from this node's metadata (spec >= 0.2.0).",
          "items": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label", "sticky", "gate", "human", "ask", "loop", "timeout", "target"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id: `<nodeId>#<index>`. Decision logs reference this."
        },
        "label": { "type": "string", "minLength": 1 },
        "sticky": {
          "type": "boolean",
          "description": "true (`+`): repeatable. false (`*`): may be taken at most once."
        },
        "gate": {
          "description": "Availability condition, or null if always available.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/gate" }]
        },
        "human": {
          "type": "boolean",
          "description": "Human checkpoint (`@human`): an agent must pause and escalate; it may not take this choice autonomously."
        },
        "ask": {
          "type": "boolean",
          "description": "Elicitation checkpoint (`@ask`): an agent opens a focused question and the edge advances only after a human answer is recorded."
        },
        "loop": {
          "type": "boolean",
          "description": "Declared loop edge (`~loop~`): intentionally revisits earlier phases. Undeclared cycles are a compile error."
        },
        "timeout": {
          "description": "Syntactic timeout edge availability, or null.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["source", "seconds"],
              "additionalProperties": false,
              "properties": {
                "source": { "type": "string" },
                "seconds": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "target": { "$ref": "#/$defs/target" },
        "line": { "type": "integer" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["source", "ast"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "description": "Original gate text, for legibility." },
        "ast": { "$ref": "#/$defs/expr" }
      }
    },
    "action": {
      "type": "object",
      "required": ["var", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "var": { "type": "string" },
        "op": { "enum": ["=", "+=", "-="] },
        "value": { "$ref": "#/$defs/expr" },
        "source": { "type": "string", "description": "Original expression text." },
        "line": { "type": "integer" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["var"],
      "additionalProperties": false,
      "properties": {
        "var": { "type": "string" },
        "line": { "type": "integer" }
      }
    },
    "target": {
      "type": "string",
      "description": "A node id, or the reserved terminal \"END\".",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "expr": {
      "description": "Expression AST. Evaluated by the runtime against the state's variables.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "lit" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "var" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "op", "operand"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "unary" },
            "op": { "enum": ["!", "-"] },
            "operand": { "$ref": "#/$defs/expr" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "op", "left", "right"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "binary" },
            "op": { "enum": ["||", "&&", "==", "!=", "<", "<=", ">", ">=", "+", "-", "*", "/", "%"] },
            "left": { "$ref": "#/$defs/expr" },
            "right": { "$ref": "#/$defs/expr" }
          }
        }
      ]
    }
  }
}
